{
  "name": "find-back",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "test:e2e": "node server/test_e2e.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
